export namespace agent {
	
	export class RosterView {
	    name: string;
	    role: string;
	    state: string;
	    writable: boolean;
	    worktree: boolean;
	    token: boolean;
	    job_id?: string;
	
	    static createFrom(source: any = {}) {
	        return new RosterView(source);
	    }
	
	    constructor(source: any = {}) {
	        if ('string' === typeof source) source = JSON.parse(source);
	        this.name = source["name"];
	        this.role = source["role"];
	        this.state = source["state"];
	        this.writable = source["writable"];
	        this.worktree = source["worktree"];
	        this.token = source["token"];
	        this.job_id = source["job_id"];
	    }
	}
	export class approvalReq {
	    RequestID: string;
	    Teammate: string;
	    Kind: string;
	    Plan: string;
	    At: number;
	
	    static createFrom(source: any = {}) {
	        return new approvalReq(source);
	    }
	
	    constructor(source: any = {}) {
	        if ('string' === typeof source) source = JSON.parse(source);
	        this.RequestID = source["RequestID"];
	        this.Teammate = source["Teammate"];
	        this.Kind = source["Kind"];
	        this.Plan = source["Plan"];
	        this.At = source["At"];
	    }
	}

}

export namespace billing {
	
	export class RateSnapshot {
	    base: string;
	    quote: string;
	    rate: number;
	    source: string;
	    asOf: string;
	    stale?: boolean;
	
	    static createFrom(source: any = {}) {
	        return new RateSnapshot(source);
	    }
	
	    constructor(source: any = {}) {
	        if ('string' === typeof source) source = JSON.parse(source);
	        this.base = source["base"];
	        this.quote = source["quote"];
	        this.rate = source["rate"];
	        this.source = source["source"];
	        this.asOf = source["asOf"];
	        this.stale = source["stale"];
	    }
	}
	export class Valuation {
	    money: Money;
	    basis: string;
	    source: string;
	    asOf: string;
	    rateSnapshot?: RateSnapshot;
	    stale?: boolean;
	
	    static createFrom(source: any = {}) {
	        return new Valuation(source);
	    }
	
	    constructor(source: any = {}) {
	        if ('string' === typeof source) source = JSON.parse(source);
	        this.money = this.convertValues(source["money"], Money);
	        this.basis = source["basis"];
	        this.source = source["source"];
	        this.asOf = source["asOf"];
	        this.rateSnapshot = this.convertValues(source["rateSnapshot"], RateSnapshot);
	        this.stale = source["stale"];
	    }
	
		convertValues(a: any, classs: any, asMap: boolean = false): any {
		    if (!a) {
		        return a;
		    }
		    if (a.slice && a.map) {
		        return (a as any[]).map(elem => this.convertValues(elem, classs));
		    } else if ("object" === typeof a) {
		        if (asMap) {
		            for (const key of Object.keys(a)) {
		                a[key] = new classs(a[key]);
		            }
		            return a;
		        }
		        return new classs(a);
		    }
		    return a;
		}
	}
	export class Money {
	    amount: string;
	    currency: string;
	
	    static createFrom(source: any = {}) {
	        return new Money(source);
	    }
	
	    constructor(source: any = {}) {
	        if ('string' === typeof source) source = JSON.parse(source);
	        this.amount = source["amount"];
	        this.currency = source["currency"];
	    }
	}
	export class CostQuote {
	    original: Money;
	    originalTotals?: Money[];
	    valuations?: Record<string, Valuation>;
	    selected?: Money;
	    billingMode?: string;
	    estimated: boolean;
	    costComplete: boolean;
	    displayComplete: boolean;
	    complete: boolean;
	    displayStatus?: string;
	    aggregateMode?: string;
	    modelRef?: string;
	    usageSource?: string;
	    pricingFingerprint?: string;
	    rateDate?: string;
	    rateBand?: string;
	    ratedAt?: string;
	    incompleteReason?: string;
	    legacyEstimate?: boolean;
	    catalogSource?: string;
	
	    static createFrom(source: any = {}) {
	        return new CostQuote(source);
	    }
	
	    constructor(source: any = {}) {
	        if ('string' === typeof source) source = JSON.parse(source);
	        this.original = this.convertValues(source["original"], Money);
	        this.originalTotals = this.convertValues(source["originalTotals"], Money);
	        this.valuations = this.convertValues(source["valuations"], Valuation, true);
	        this.selected = this.convertValues(source["selected"], Money);
	        this.billingMode = source["billingMode"];
	        this.estimated = source["estimated"];
	        this.costComplete = source["costComplete"];
	        this.displayComplete = source["displayComplete"];
	        this.complete = source["complete"];
	        this.displayStatus = source["displayStatus"];
	        this.aggregateMode = source["aggregateMode"];
	        this.modelRef = source["modelRef"];
	        this.usageSource = source["usageSource"];
	        this.pricingFingerprint = source["pricingFingerprint"];
	        this.rateDate = source["rateDate"];
	        this.rateBand = source["rateBand"];
	        this.ratedAt = source["ratedAt"];
	        this.incompleteReason = source["incompleteReason"];
	        this.legacyEstimate = source["legacyEstimate"];
	        this.catalogSource = source["catalogSource"];
	    }
	
		convertValues(a: any, classs: any, asMap: boolean = false): any {
		    if (!a) {
		        return a;
		    }
		    if (a.slice && a.map) {
		        return (a as any[]).map(elem => this.convertValues(elem, classs));
		    } else if ("object" === typeof a) {
		        if (asMap) {
		            for (const key of Object.keys(a)) {
		                a[key] = new classs(a[key]);
		            }
		            return a;
		        }
		        return new classs(a);
		    }
		    return a;
		}
	}
	
	

}

